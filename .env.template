DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/mydatabase?sslmode=disable
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
JWT_SECRET=jwt-secret
SERVER_URL=http://localhost:5500

# Local-dev-only Google OAuth bypass. Comma-separated allow-list of emails
# that can sign in via POST /dev-login without going through Google.
# NEVER set this in production — the route 404s if NODE_ENV=production, but
# treat it as a secret regardless.
# DEV_LOGIN_BYPASS_EMAILS=you@example.com

# Google Analytics Configuration
GA4_PROPERTY_ID=your-ga4-property-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# OR use JSON key directly:
# GA_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
